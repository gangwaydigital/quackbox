# QuackBox — environment overrides
# Copy to .env and edit. Anything left commented uses the docker-compose default.

# ── Data location ─────────────────────────────────────────────────────────
# Host directory containing your .mbox / .emlx archives. Bind-mounted into the
# backend at /app/data. Defaults to ./data inside the project.
# Examples:
#   DATA_PATH=/Users/you/Library/Mail/V10
#   DATA_PATH=/Volumes/RAID/BU/V10
# DATA_PATH=./data

# Mount mode: "ro" for read-only (recommended for backups you don't want
# touched), "rw" if QuackBox needs to write into the source dir. Default rw.
# DATA_MOUNT_MODE=ro

# ── Chat LLM (Q&A and summarization) ──────────────────────────────────────
# CHAT_API_URL=http://host.docker.internal:11434
# CHAT_API_KEY=
# CHAT_MODEL=llama3.1:8b
# CHAT_API_TYPE=ollama        # "ollama" or "openai"

# ── Embedding LLM (semantic search and topic clustering) ──────────────────
# EMBED_API_URL=http://host.docker.internal:11434
# EMBED_API_KEY=
# EMBED_MODEL=nomic-embed-text
# EMBED_API_TYPE=ollama       # "ollama" or "openai"
# EMBEDDING_DIMENSIONS=768
