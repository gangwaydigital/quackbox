# QuackBox — environment overrides
# Copy to .env and edit. Anything left commented uses the docker-compose default.

# ── Data location ─────────────────────────────────────────────────────────
# Host directory containing your .mbox / .emlx archives. Bind-mounted into the
# backend at /app/data. Defaults to ./data inside the project.
# Examples:
#   DATA_PATH=/Users/you/Library/Mail/V10
#   DATA_PATH=/Volumes/RAID/BU/V10
# DATA_PATH=./data

# Mount mode: "ro" for read-only (recommended for backups you don't want
# touched), "rw" if QuackBox needs to write into the source dir. Default rw.
# DATA_MOUNT_MODE=ro

# ── Background watcher (auto re-import) ───────────────────────────────────
# How often the backend checks DATA_PATH for new email content and runs an
# incremental ingest if anything is found. Set to a positive integer in
# minutes to enable. 0 disables (default). Minimum effective value is 1.
# WATCH_INTERVAL_MINUTES=15

# When enabled, also run an immediate ingest at startup if there's pending
# work. Default false.
# WATCH_ON_STARTUP=true

# ── Chat LLM (Q&A and summarization) ──────────────────────────────────────
# CHAT_API_URL=http://host.docker.internal:11434
# CHAT_API_KEY=
# CHAT_MODEL=llama3.1:8b
# CHAT_API_TYPE=ollama        # "ollama" or "openai"

# ── Embedding LLM (semantic search and topic clustering) ──────────────────
#
# Recommended embedding models (set EMBED_MODEL + matching EMBEDDING_DIMENSIONS):
#
#   nomic-embed-text         274 MB  768 dim   default — solid quality, moderate speed
#   all-minilm                46 MB  384 dim   ~5x faster, good for large archives
#   mxbai-embed-large        670 MB 1024 dim   higher quality, slower
#   snowflake-arctic-embed   335 MB 1024 dim   strong English benchmarks
#
# OpenAI-compatible (EMBED_API_TYPE=openai):
#   text-embedding-3-small   1536 dim   fast + cheap
#   text-embedding-3-large   3072 dim   highest quality
#
# After switching, re-run clustering — embeddings from different models
# aren't interchangeable.
#
# EMBED_API_URL=http://host.docker.internal:11434
# EMBED_API_KEY=
# EMBED_MODEL=nomic-embed-text
# EMBED_API_TYPE=ollama       # "ollama" or "openai"
# EMBEDDING_DIMENSIONS=768
